# Copy this file to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=4000
# Where the React app runs; used to build verification links.
CLIENT_ORIGIN=http://localhost:5173

# MySQL connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=campusbazaar_app
DB_PASSWORD=
DB_NAME=campusbazaar

# Long random string (at least 32 characters) used to sign session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Comma-separated university email domains allowed to register, e.g. youruniversity.ac.in
ALLOWED_EMAIL_DOMAINS=

# Email delivery (any SMTP provider). Leave SMTP_HOST empty in development to print
# verification emails to the server console instead. Required in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=CampusBazaar <no-reply@example.com>
